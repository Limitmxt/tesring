# ---------------------------------------------------------------------------
# Phone Deal Scanner — environment template
# Copy this file to ".env.local" and fill in your own values.
# ---------------------------------------------------------------------------

# --- eBay Browse API (required for live search) --------------------------- #
# Create an app at https://developer.ebay.com/ -> "My Account" -> "Application
# Keys". You need the *production* App ID (Client ID) and Cert ID (Client
# Secret). The app uses the OAuth2 "client credentials" grant, so no user
# login is required — only these two values.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# eBay API environment + marketplace.
#   EBAY_ENV: "production" (default) or "sandbox"
#   EBAY_MARKETPLACE_ID: e.g. EBAY_US, EBAY_GB, EBAY_DE
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_US

# Optional: eBay affiliate Campaign ID. If set, listing links returned by the
# Browse API include your affiliate tracking. Leave blank if you don't have one.
EBAY_AFFILIATE_CAMPAIGN_ID=

# --- Anthropic (optional — enables the AI listing classifier) ------------- #
# Without this key the app still works: it falls back to the deterministic,
# rule-based classifier. Set it to get plain-English AI explanations.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for classification. Defaults to claude-opus-4-8 if unset.
# For high-volume/cheaper classification you can switch to claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Database ------------------------------------------------------------- #
# Path to the SQLite file (created automatically on first run).
DATABASE_PATH=./data/scanner.db
